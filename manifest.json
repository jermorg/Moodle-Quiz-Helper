{
    "manifest_version": 3,
    "name": "Moodle Quiz Sync",
    "version": "1.3.2",
    "description": "Автоматичний збір та підсвічування відповідей у тестах Moodle",
    "browser_specific_settings": {
        "gecko": {
            "id": "moodle-quiz-helper@jermorg",
            "strict_min_version": "115.0",
                "data_collection_permissions": {
                    "required": ["websiteContent"]
                }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://*/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://dist.nupp.edu.ua/*"
            ],
            "css": [
                "styles/background.css"
            ],
            "js": [
                "libs/jquery.min.js",
                "background.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "database/*.js",
                "parser/*.js",
                "shared/*.js"
            ],
            "matches": [
                "https://dist.nupp.edu.ua/*"
            ]
        }
    ]
}