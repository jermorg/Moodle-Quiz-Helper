{
    "manifest_version": 3,
    "name": "Moodle Quiz Helper",
    "version": "1.0",
    "description": "Універсальний парсер та фонова підсвітка відповідей у Moodle",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
        "matches": [
            "https://dist.nupp.edu.ua/mod/quiz/*"
        ],
        "js": [
            "libs/jquery.min.js",
            "background.js"
        ],
        "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
        "resources": [
            "database/*.js",
            "shared/*.js"
        ],
        "matches": ["https://dist.nupp.edu.ua/*"]
        }
    ]
}